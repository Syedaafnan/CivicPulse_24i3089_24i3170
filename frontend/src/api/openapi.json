{
  "openapi": "3.1.0",
  "info": {
    "title": "CivicPulse API",
    "description": "Municipal complaint intake, AI triage and operations.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/complaints": {
      "post": {
        "tags": [
          "complaints"
        ],
        "summary": "Create Complaint",
        "operationId": "create_complaint_api_complaints_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComplaintCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "complaints"
        ],
        "summary": "List Complaints",
        "operationId": "list_complaints_api_complaints_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Category"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Priority"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Priority"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Status"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintPage"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/complaints/{complaint_id}": {
      "get": {
        "tags": [
          "complaints"
        ],
        "summary": "Get Complaint",
        "operationId": "get_complaint_api_complaints__complaint_id__get",
        "parameters": [
          {
            "name": "complaint_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Complaint Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/complaints/{complaint_id}/status": {
      "patch": {
        "tags": [
          "complaints"
        ],
        "summary": "Change Status",
        "operationId": "change_status_api_complaints__complaint_id__status_patch",
        "parameters": [
          {
            "name": "complaint_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Complaint Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransitionErrorBody"
                }
              }
            },
            "description": "Conflict"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Get Stats",
        "operationId": "get_stats_api_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta/providers": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Providers",
        "operationId": "providers_api_meta_providers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta/enums": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Enums",
        "description": "Vocabulary for UI filters, so the frontend never hard-codes domain values.",
        "operationId": "enums_api_meta_enums_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnumsOut"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "A dependency is unreachable or the pod is draining"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "water",
          "electricity",
          "sanitation",
          "roads",
          "streetlights",
          "other"
        ],
        "title": "Category"
      },
      "ComplaintCreate": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Text",
            "examples": [
              "Burst water main flooding Street 12 since fajr"
            ]
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Location",
            "examples": [
              "G-11/3, Street 12"
            ]
          },
          "reporter_contact": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporter Contact"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "location"
        ],
        "title": "ComplaintCreate"
      },
      "ComplaintOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "reporter_contact": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporter Contact"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "ai_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Summary"
          },
          "triaged_by": {
            "type": "string",
            "title": "Triaged By"
          },
          "triage_latency_ms": {
            "type": "integer",
            "title": "Triage Latency Ms"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "allowed_transitions": {
            "items": {
              "$ref": "#/components/schemas/Status"
            },
            "type": "array",
            "title": "Allowed Transitions",
            "description": "Statuses this complaint may move to next, decided by the server's state machine."
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "location",
          "reporter_contact",
          "category",
          "priority",
          "status",
          "ai_summary",
          "triaged_by",
          "triage_latency_ms",
          "created_at",
          "updated_at",
          "allowed_transitions"
        ],
        "title": "ComplaintOut"
      },
      "ComplaintPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ComplaintOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "ComplaintPage"
      },
      "EnumsOut": {
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "type": "array",
            "title": "Categories"
          },
          "priorities": {
            "items": {
              "$ref": "#/components/schemas/Priority"
            },
            "type": "array",
            "title": "Priorities"
          },
          "statuses": {
            "items": {
              "$ref": "#/components/schemas/Status"
            },
            "type": "array",
            "title": "Statuses"
          }
        },
        "type": "object",
        "required": [
          "categories",
          "priorities",
          "statuses"
        ],
        "title": "EnumsOut"
      },
      "ErrorBody": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorBody"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Priority": {
        "type": "string",
        "enum": [
          "high",
          "normal",
          "low"
        ],
        "title": "Priority"
      },
      "ProvidersOut": {
        "properties": {
          "active": {
            "type": "string",
            "title": "Active"
          },
          "fallback": {
            "type": "string",
            "title": "Fallback"
          },
          "available": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Available"
          },
          "cache_hits": {
            "type": "integer",
            "title": "Cache Hits"
          },
          "cache_misses": {
            "type": "integer",
            "title": "Cache Misses"
          },
          "cache_hit_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cache Hit Rate"
          },
          "recent": {
            "items": {
              "$ref": "#/components/schemas/TriageOutcome"
            },
            "type": "array",
            "title": "Recent"
          }
        },
        "type": "object",
        "required": [
          "active",
          "fallback",
          "available",
          "cache_hits",
          "cache_misses",
          "cache_hit_rate",
          "recent"
        ],
        "title": "ProvidersOut"
      },
      "StatsOut": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "by_category": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Category"
            },
            "type": "object",
            "title": "By Category"
          },
          "by_priority": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Priority"
            },
            "type": "object",
            "title": "By Priority"
          },
          "by_status": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Status"
            },
            "type": "object",
            "title": "By Status"
          },
          "by_triaged_by": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Triaged By"
          },
          "avg_triage_latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Triage Latency Ms"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "total",
          "by_category",
          "by_priority",
          "by_status",
          "by_triaged_by",
          "avg_triage_latency_ms",
          "generated_at"
        ],
        "title": "StatsOut"
      },
      "Status": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "rejected"
        ],
        "title": "Status"
      },
      "StatusUpdate": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusUpdate"
      },
      "TransitionErrorBody": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "current": {
            "$ref": "#/components/schemas/Status"
          },
          "attempted": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "current",
          "attempted"
        ],
        "title": "TransitionErrorBody"
      },
      "TriageOutcome": {
        "properties": {
          "complaint_id": {
            "type": "string",
            "title": "Complaint Id"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "fallback": {
            "type": "boolean",
            "title": "Fallback"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "complaint_id",
          "provider",
          "latency_ms",
          "fallback",
          "cached",
          "at"
        ],
        "title": "TriageOutcome"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationErrorBody": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": "Validation failed"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "errors"
        ],
        "title": "ValidationErrorBody"
      }
    }
  }
}
