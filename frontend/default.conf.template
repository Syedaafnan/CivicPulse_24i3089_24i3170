# Rendered at container start by the official image's envsubst step
# (only ${BACKEND_UPSTREAM} is defined in the environment, so nginx's own $vars are untouched).
server {
  listen 8080;
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;

  location = /healthz { access_log off; return 200 "ok\n"; }

  # Runtime config: regenerated on every start, never cached.
  location = /config.js { add_header Cache-Control "no-store" always; }

  # Same-origin API: the browser only ever talks to this nginx, so no CORS and no backend URL in JS.
  location /api/ {
    proxy_pass ${BACKEND_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-ID $http_x_request_id;
    proxy_read_timeout 30s;   # > 2 x 10 s LLM attempts + jitter
  }

  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }

  # SPA routes (/submit, /dashboard, /stats) fall back to index.html
  location / { try_files $uri /index.html; }
}
