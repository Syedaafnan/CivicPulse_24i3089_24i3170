# Copy to .env and fill in. .env is gitignored — never commit it.
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=civicpulse

# llm | ollama | rules | simulated
TRIAGE_PROVIDER=rules
# Free Groq key from https://console.groq.com (only needed when TRIAGE_PROVIDER=llm)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_PROVIDER_LABEL=groq
OLLAMA_MODEL=llama3.2:1b

RATE_LIMIT_REQUESTS=10
